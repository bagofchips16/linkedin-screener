# Job sources (at least one). Free Adzuna keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Google Jobs via https://serpapi.com
SERPAPI_KEY=

# Search and quality filters
JOB_SEARCH_TERMS=HR Manager,HR Business Partner,Talent Acquisition,Head of HR,People Operations
MIN_EXPERIENCE_YEARS=3
MIN_SALARY_LPA=35
# true = drop jobs that do not disclose salary
REQUIRE_SALARY=false
MIN_QUALITY_SCORE=50
POLL_MINUTES=60

# Email alerts (for Gmail use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
